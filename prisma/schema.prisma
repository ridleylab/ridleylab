datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String   // Hashed password
  role      String?
  bio       String?
  avatarUrl String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     TagOnPost[]
  createdAt DateTime @default(now())
}

model Post {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogImage         String?
  faqJson         Json?
  coverImage      String?
  contentPath     String?     // Legacy nullable column retained in Neon DB for 100% additive push

  content         String      @default("") // Rich-text HTML / Markdown content stored directly in database
  readingTime     String?
  draft           Boolean     @default(true)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  tags            TagOnPost[]

  authorId        String?
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String      @default("RidleyLab")

  @@index([draft, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model TagOnPost {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
